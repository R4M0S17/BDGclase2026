DATABASE_URL=postgresql://localhost:5432/ticket_manager
JWT_SECRET=dev-secret-cualquier-cosa-sirve
NODE_ENV=development
PORT=3000

# CORS — origin permitido en producción (ej: https://mi-app.com)
# En desarrollo se acepta cualquier origen automáticamente
CORS_ORIGIN=http://localhost:5173

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Microsoft (Entra ID)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
